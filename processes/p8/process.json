{
  "schemaVersion": 1,
  "key": "p8_onsite_verification",
  "name": "Verificare la fața locului",
  "description": "Pachetul P8: vizita pe teren a ofițerului de monitorizare (art. 74 din Regulamentul (UE) 2021/1060, OUG 23/2023 art. 14, Anexa 6 la Ordinul MIPE 1777/2023): programare (planificată, de monitorizare, ad-hoc fără notificare, încrucișată, la cererea finală, ex-post), pregătire (dosar, echipamente, riscuri), verificare pe secțiunile Anexei 6 cu fotografii GPS și semnătura reprezentantului, raport în 10 zile lucrătoare avizat și aprobat, urmărirea recomandărilor și escaladare.",
  "subject": {
    "requires": [
      "project",
      "beneficiary"
    ]
  },
  "fields": [
    {
      "key": "smis_code",
      "label": "Cod SMIS",
      "type": "text",
      "prefill": {
        "from": "project",
        "path": "smis_code"
      }
    },
    {
      "key": "project_title",
      "label": "Titlul proiectului",
      "type": "text",
      "prefill": {
        "from": "project",
        "path": "title"
      }
    },
    {
      "key": "beneficiary_name",
      "label": "Beneficiar",
      "type": "text",
      "prefill": {
        "from": "beneficiary",
        "path": "name"
      }
    },
    {
      "key": "contract_number",
      "label": "Contract de finanțare nr.",
      "type": "text",
      "prefill": {
        "from": "project",
        "path": "contract_number"
      }
    },
    {
      "key": "visit_reason",
      "label": "Tipul vizitei",
      "type": "choice",
      "nomenclature": "visit_reason"
    },
    {
      "key": "project_kind",
      "label": "Tipul investiției verificate",
      "type": "choice",
      "nomenclature": "visit_project_kind"
    },
    {
      "key": "visit_scope",
      "label": "Scopul vizitei",
      "type": "textarea"
    },
    {
      "key": "sampled_reference",
      "label": "Cererea / dosarul verificat",
      "type": "text"
    },
    {
      "key": "planned_date",
      "label": "Data programată",
      "type": "date"
    },
    {
      "key": "location",
      "label": "Locul de implementare (adresa)",
      "type": "text"
    },
    {
      "key": "beneficiary_contact",
      "label": "Persoana de contact la beneficiar",
      "type": "text"
    },
    {
      "key": "notice_documents",
      "label": "Documente pe care beneficiarul le pune la dispoziție",
      "type": "textarea",
      "prefill": {
        "from": "constant",
        "value": "Originalele contractelor de achiziție și ale actelor adiționale, facturile și procesele-verbale de recepție, situațiile de lucrări, autorizația de construire și ordinul de începere, jurnalul de șantier, documentele de personal (decizii, fișe de post, pontaje), evidența contabilă analitică a proiectului."
      }
    },
    {
      "key": "visibility_requirement",
      "label": "Cerința de vizibilitate pentru acest proiect",
      "type": "calculated",
      "resultType": "text",
      "formula": {
        "if": [
          {
            "amount_gte": [
              {
                "var": "project.total_value"
              },
              "49700000"
            ]
          },
          "Operațiune > 10 mil. EUR: panou/plăcuță permanentă, plus eveniment de comunicare (inaugurare), materiale foto/video, campanie și clip final, conform planului de comunicare",
          {
            "and": [
              {
                "amount_gte": [
                  {
                    "var": "project.total_value"
                  },
                  "2485000"
                ]
              },
              {
                "in": [
                  {
                    "var": "fields.project_kind"
                  },
                  [
                    "lucrari",
                    "eficienta_energetica"
                  ]
                ]
              }
            ]
          },
          "Infrastructură > 500.000 EUR: panou temporar de min. 2 × 1,5 m pe durata lucrărilor, apoi plăcuță/panou permanent de min. 0,8 × 0,5 m (drumuri județene: cel puțin 3 panouri cu două fețe)",
          {
            "amount_gte": [
              {
                "var": "project.total_value"
              },
              "2485000"
            ]
          },
          "Bunuri / servicii > 500.000 EUR: panou sau plăcuță permanentă de min. 0,8 × 0,5 m, la loc vizibil",
          "Sub 500.000 EUR: cel puțin un afiș A3 sau un afișaj electronic echivalent, la loc vizibil publicului"
        ]
      }
    },
    {
      "key": "team",
      "label": "Echipa de verificare",
      "type": "line_items",
      "columns": [
        {
          "key": "name",
          "label": "Nume și prenume",
          "type": "text"
        },
        {
          "key": "role",
          "label": "Calitatea",
          "type": "choice",
          "nomenclature": "visit_team_role"
        }
      ]
    },
    {
      "key": "declared_progress",
      "label": "Ce a declarat beneficiarul (ultimul raport de progres)",
      "type": "textarea"
    },
    {
      "key": "stage_indicators_due",
      "label": "Indicatori de etapă scadenți (planul de monitorizare)",
      "type": "textarea"
    },
    {
      "key": "main_risk",
      "label": "Unde este riscul cel mai mare (ce verific cu prioritate)",
      "type": "textarea"
    },
    {
      "key": "equipment",
      "label": "Echipamente de verificat",
      "type": "line_items",
      "columns": [
        {
          "key": "item",
          "label": "Denumire",
          "type": "text"
        },
        {
          "key": "quantity",
          "label": "Cant.",
          "type": "integer"
        },
        {
          "key": "serial_expected",
          "label": "Seria din factură / PV",
          "type": "text"
        },
        {
          "key": "invoice",
          "label": "Factura / PV recepție",
          "type": "text"
        },
        {
          "key": "placement",
          "label": "Amplasare",
          "type": "text"
        },
        {
          "key": "status",
          "label": "Constatare",
          "type": "choice",
          "nomenclature": "equipment_status"
        },
        {
          "key": "serial_found",
          "label": "Seria găsită",
          "type": "text"
        },
        {
          "key": "observation",
          "label": "Observații",
          "type": "text"
        }
      ],
      "rowValidations": [
        {
          "rule": {
            "or": [
              {
                "!": {
                  "var": "row.status"
                }
              },
              {
                "==": [
                  {
                    "var": "row.status"
                  },
                  "conform"
                ]
              },
              {
                "!!": {
                  "var": "row.observation"
                }
              }
            ]
          },
          "message": "un echipament care nu este conform are nevoie de observații."
        }
      ]
    },
    {
      "key": "works_sampling",
      "label": "Măsurători prin sondaj (situații de lucrări)",
      "type": "line_items",
      "columns": [
        {
          "key": "position",
          "label": "Poziția",
          "type": "text"
        },
        {
          "key": "description",
          "label": "Descriere",
          "type": "text"
        },
        {
          "key": "unit",
          "label": "UM",
          "type": "text"
        },
        {
          "key": "qty_paid",
          "label": "Cantitate decontată",
          "type": "amount",
          "currency": false
        },
        {
          "key": "qty_measured",
          "label": "Cantitate măsurată",
          "type": "amount",
          "currency": false
        },
        {
          "key": "difference",
          "label": "Diferență %",
          "type": "calculated",
          "resultType": "percent",
          "formula": {
            "if": [
              {
                ">": [
                  {
                    "var": "row.qty_paid"
                  },
                  0
                ]
              },
              {
                "round": [
                  {
                    "*": [
                      {
                        "/": [
                          {
                            "-": [
                              {
                                "var": "row.qty_measured"
                              },
                              {
                                "var": "row.qty_paid"
                              }
                            ]
                          },
                          {
                            "var": "row.qty_paid"
                          }
                        ]
                      },
                      100
                    ]
                  },
                  1
                ]
              },
              null
            ]
          }
        }
      ]
    },
    {
      "key": "previous_recommendations",
      "label": "Recomandările vizitei anterioare",
      "type": "line_items",
      "prefill": {
        "from": "previous_instance",
        "path": "recommendations"
      },
      "columns": [
        {
