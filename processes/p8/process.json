      "key": "visit_notice",
      "template": "p8_visit_notice",
      "docType": "onsite_visit_notice",
      "signatureLevel": "qualified"
    },
    {
      "key": "visit_report",
      "template": "p8_visit_report",
      "docType": "onsite_visit_report",
      "signatureLevel": "qualified",
      "appendEvidence": true
    }
  ],
  "deadlines": [
    {
      "key": "report",
      "definition": "onsite_report",
      "startsAt": "visit",
      "stopsAt": [
        "director_approval"
      ]
    },
    {
      "key": "follow_up",
      "definition": "onsite_follow_up",
      "startsAt": "follow_up",
      "stopsAt": [
        "done",
        "closed_irregularity"
      ]
    }
  ],
  "separationOfDuties": [
    {
      "steps": [
        "visit",
        "head_review"
      ],
      "message": "Cel care a efectuat vizita nu poate aviza raportul."
    }
  ],
  "steps": [
    {
      "key": "planning",
      "type": "start",
      "name": "Programarea vizitei",
      "fieldAccess": {
        "visit_reason": "required",
        "project_kind": "required",
        "visit_scope": "required",
        "sampled_reference": "editable",
        "planned_date": "required",
        "location": "required",
        "beneficiary_contact": "editable",
        "notice_documents": "editable",
        "team": "hidden",
        "declared_progress": "hidden",
        "stage_indicators_due": "hidden",
        "main_risk": "hidden",
        "equipment": "hidden",
        "works_sampling": "hidden",
        "previous_recommendations": "hidden",
        "visit_date": "hidden",
        "beneficiary_participants": "hidden",
        "representative": "hidden",
        "representative_role": "hidden",
        "documents_checked": "hidden",
        "contract_findings": "hidden",
        "procurement_findings": "hidden",
        "stage_findings": "hidden",
        "indicators_findings": "hidden",
        "equipment_findings": "hidden",
        "works_findings": "hidden",
        "deliverables_findings": "hidden",
        "payments_findings": "hidden",
        "durability_findings": "hidden",
        "management_findings": "hidden",
        "horizontal_findings": "hidden",
        "visibility_findings": "hidden",
        "other_findings": "hidden",
        "risks": "hidden",
        "findings": "hidden",
        "deviation_type": "hidden",
        "result": "hidden",
        "recommendations": "hidden",
        "beneficiary_position": "hidden",
        "missing_documents": "hidden",
        "escalation_level": "hidden",
        "follow_up_notes": "hidden"
      },
      "paths": [
        {
          "key": "schedule",
          "label": "Programează vizita",
          "to": "route_notice",
          "validations": [
            {
              "rule": {
                ">=": [
                  {
                    "var": "fields.planned_date"
                  },
                  {
                    "var": "today"
                  }
                ]
              },
              "message": "Data programată nu poate fi în trecut."
            }
          ]
        },
        {
          "key": "cancel",
          "label": "Renunță la vizită",
          "to": "cancelled",
          "kind": "reject",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "route_notice",
      "type": "decision",
      "name": "Notificare prealabilă?",
      "paths": [
        {
          "key": "unannounced",
          "label": "Vizită inopinată – fără notificare",
          "to": "prepare",
          "visibleWhen": {
            "in": [
              {
                "var": "fields.visit_reason"
              },
              [
                "ad_hoc",
                "suspiciune"
              ]
            ]
          }
        },
        {
          "key": "notify",
          "label": "Cu notificare prin MySMIS",
          "to": "notify_visit",
          "visibleWhen": {
            "!": {
              "in": [
                {
                  "var": "fields.visit_reason"
                },
                [
                  "ad_hoc",
                  "suspiciune"
                ]
              ]
            }
          }
        }
      ]
    },
    {
      "key": "notify_visit",
      "type": "system",
      "name": "Notificarea beneficiarului",
      "onEnter": [
        {
          "type": "register",
          "register": "onsite_visits",
          "direction": "internal",
          "once": true
        },
        {
          "type": "generate_document",
          "document": "visit_notice"
        },
        {
          "type": "register",
          "register": "general",
          "direction": "out",
          "document": "visit_notice"
        },
        {
          "type": "notify",
          "to": "beneficiary_email",
          "template": "p8_visit_notice_email",
          "attach": [
            "visit_notice"
          ]
        }
      ],
      "next": "prepare"
    },
    {
      "key": "prepare",
      "type": "human",
      "name": "Pregătirea vizitei",
      "assignment": {
        "rule": "project_expert",
        "role": "ei_expert"
      },
      "checklist": "prepare",
      "checklistVerifier": "primary",
      "fieldAccess": {
        "visit_reason": "visible",
        "project_kind": "required",
        "visit_scope": "visible",
        "sampled_reference": "visible",
        "planned_date": "visible",
        "location": "visible",
        "beneficiary_contact": "visible",
        "notice_documents": "visible",
        "team": "required",
        "declared_progress": "editable",
        "stage_indicators_due": "editable",
        "main_risk": "required",
        "equipment": "editable",
        "works_sampling": "editable",
        "previous_recommendations": "editable",
        "visit_date": "hidden",
        "beneficiary_participants": "hidden",
        "representative": "hidden",
        "representative_role": "hidden",
        "documents_checked": "hidden",
        "contract_findings": "hidden",
        "procurement_findings": "hidden",
        "stage_findings": "hidden",
        "indicators_findings": "hidden",
        "equipment_findings": "hidden",
        "works_findings": "hidden",
        "deliverables_findings": "hidden",
        "payments_findings": "hidden",
        "durability_findings": "hidden",
        "management_findings": "hidden",
        "horizontal_findings": "hidden",
        "visibility_findings": "hidden",
        "other_findings": "hidden",
        "risks": "hidden",
        "findings": "hidden",
        "deviation_type": "hidden",
        "result": "hidden",
        "recommendations": "hidden",
        "beneficiary_position": "hidden",
        "missing_documents": "hidden",
        "escalation_level": "hidden",
        "follow_up_notes": "hidden"
      },
      "onEnter": [
        {
          "type": "register",
          "register": "onsite_visits",
          "direction": "internal",
          "once": true,
          "when": {
            "in": [
              {
                "var": "fields.visit_reason"
              },
              [
                "ad_hoc",
                "suspiciune"
              ]
            ]
          }
        }
      ],
      "paths": [
        {
          "key": "ready",
          "label": "Pregătirea este completă – plec pe teren",
          "to": "visit",
          "requiresChecklistComplete": "prepare"
        },
        {
          "key": "reschedule",
          "label": "Returnează pentru reprogramare",
          "to": "planning",
          "kind": "return",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "visit",
      "type": "human",
      "name": "Vizita la fața locului",
      "assignment": {
        "rule": "previous_actor",
        "step": "prepare",
        "role": "ei_expert"
      },
      "deadline": "report",
      "checklist": "onsite",
      "checklistVerifier": "primary",
      "evidence": true,
      "fieldAccess": {
        "visit_reason": "visible",
        "project_kind": "visible",
        "visit_scope": "visible",
        "sampled_reference": "visible",
        "planned_date": "visible",
        "location": "visible",
        "beneficiary_contact": "visible",
        "notice_documents": "visible",
        "team": "editable",
        "declared_progress": "visible",
        "stage_indicators_due": "visible",
        "main_risk": "visible",
        "equipment": "editable",
        "works_sampling": "editable",
        "previous_recommendations": "editable",
        "visit_date": "required",
        "beneficiary_participants": "required",
        "representative": "required",
        "representative_role": "editable",
        "documents_checked": "required",
        "contract_findings": "editable",
        "procurement_findings": "editable",
        "stage_findings": "editable",
        "indicators_findings": "editable",
        "equipment_findings": "editable",
        "works_findings": "editable",
        "deliverables_findings": "editable",
        "payments_findings": "editable",
        "durability_findings": "editable",
        "management_findings": "editable",
        "horizontal_findings": "editable",
        "visibility_findings": "editable",
        "other_findings": "editable",
        "risks": "editable",
        "findings": "required",
        "deviation_type": "required",
        "result": "required",
        "recommendations": "editable",
        "beneficiary_position": "editable",
        "missing_documents": "editable",
        "escalation_level": "editable",
        "follow_up_notes": "hidden"
      },
      "paths": [
        {
          "key": "submit",
          "label": "Trimite raportul la avizare",
          "to": "head_review",
          "requiresSignatures": [
            "visit_report"
          ],
          "requiresChecklistComplete": "onsite",
          "validations": [
            {
              "rule": {
                ">=": [
                  {
                    "var": "evidence.photos"
                  },
                  1
                ]
              },
              "message": "Atașați cel puțin o fotografie de la locul implementării."
            },
            {
              "rule": {
                "==": [
                  {
                    "var": "evidence.signature"
                  },
                  true
                ]
              },
              "message": "Lipsește semnătura reprezentantului beneficiarului."
            },
            {
              "rule": {
                "none": [
                  {
                    "var": "fields.equipment"
                  },
                  {
                    "!": {
                      "var": "status"
                    }
                  }
                ]
              },
              "message": "Completați constatarea pentru fiecare echipament din listă (găsit, serie diferită, nefuncțional, lipsă)."
            },
            {
              "rule": {
                "none": [
                  {
                    "var": "fields.previous_recommendations"
                  },
                  {
                    "!": {
                      "var": "status"
                    }
                  }
                ]
              },
              "message": "Stabiliți stadiul fiecărei recomandări din vizita anterioară (punctul 5)."
            },
            {
              "rule": {
                "none": [
                  {
                    "var": "fields.documents_checked"
                  },
                  {
                    "!": {
                      "var": "method"
                    }
                  }
                ]
              },
              "message": "Indicați metoda de verificare (integral / eșantion) pentru fiecare document (punctul 13)."
            },
            {
              "rule": {
                "or": [
                  {
                    "==": [
                      {
                        "var": "fields.visit_reason"
                      },
                      "ex_post"
                    ]
                  },
                  {
                    "!!": {
                      "var": "fields.stage_findings"
                    }
                  }
                ]
              },
              "message": "Descrieți stadiul activităților față de grafic (punctul 2.2)."
            },
            {
              "rule": {
                "or": [
                  {
                    "!=": [
                      {
                        "var": "fields.visit_reason"
                      },
                      "ex_post"
                    ]
                  },
                  {
                    "!!": {
                      "var": "fields.durability_findings"
                    }
                  }
                ]
              },
              "message": "Descrieți constatările privind durabilitatea (secțiunea II)."
            },
            {
              "rule": {
                "or": [
                  {
                    "==": [
                      {
                        "var": "fields.result"
                      },
                      "conform"
                    ]
                  },
                  {
                    ">": [
                      {
                        "var": "fields.recommendations.length"
                      },
                      0
                    ]
                  }
                ]
              },
              "message": "Formulați cel puțin o recomandare, cu termen și dovada cerută (punctul 12)."
            },
            {
              "rule": {
                "or": [
                  {
                    "!=": [
                      {
                        "var": "fields.result"
                      },
                      "neconform"
                    ]
                  },
                  {
                    "in": [
                      {
                        "var": "fields.deviation_type"
                      },
                      [
                        "suspiciune_neregula",
                        "suspiciune_frauda"
                      ]
                    ]
                  }
                ]
              },
              "message": "Rezultatul „neconform” trimite dosarul la nereguli și presupune o suspiciune de neregulă sau fraudă. O întârziere nu este, în sine, neregulă: folosiți „conform, cu recomandări”."
            },
            {
              "rule": {
                "or": [
                  {
                    "!": {
                      "in": [
                        {
                          "var": "fields.deviation_type"
                        },
                        [
                          "suspiciune_neregula",
                          "suspiciune_frauda"
                        ]
                      ]
                    }
                  },
                  {
                    "==": [
                      {
                        "var": "fields.result"
                      },
                      "neconform"
                    ]
                  }
                ]
              },
              "message": "O suspiciune de neregulă sau fraudă se semnalează ierarhic: rezultatul trebuie să fie „neconform”."
            }
          ]
        },
        {
          "key": "reschedule",
          "label": "Vizita nu a putut avea loc – reprogramează",
          "to": "planning",
          "kind": "return",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "head_review",
      "type": "human",
      "name": "Avizare șef serviciu",
      "assignment": {
        "rule": "department_head",
        "step": "visit"
      },
      "fieldAccess": {
        "smis_code": "visible",
        "project_title": "visible",
        "beneficiary_name": "visible",
        "contract_number": "visible",
        "visit_reason": "visible",
        "project_kind": "visible",
        "visit_scope": "visible",
        "sampled_reference": "visible",
        "planned_date": "visible",
        "location": "visible",
        "beneficiary_contact": "visible",
        "notice_documents": "visible",
        "visibility_requirement": "visible",
        "team": "visible",
        "declared_progress": "visible",
        "stage_indicators_due": "visible",
        "main_risk": "visible",
        "equipment": "visible",
        "works_sampling": "visible",
        "previous_recommendations": "visible",
        "visit_date": "visible",
        "beneficiary_participants": "visible",
        "representative": "visible",
        "representative_role": "visible",
        "documents_checked": "visible",
        "contract_findings": "visible",
        "procurement_findings": "visible",
        "stage_findings": "visible",
        "indicators_findings": "visible",
        "equipment_findings": "visible",
        "works_findings": "visible",
        "deliverables_findings": "visible",
        "payments_findings": "visible",
        "durability_findings": "visible",
        "management_findings": "visible",
        "horizontal_findings": "visible",
        "visibility_findings": "visible",
        "other_findings": "visible",
        "risks": "visible",
        "findings": "visible",
        "deviation_type": "visible",
        "result": "visible",
        "recommendations": "visible",
        "beneficiary_position": "visible",
        "missing_documents": "visible",
        "escalation_level": "editable",
        "follow_up_notes": "hidden"
      },
      "paths": [
        {
          "key": "endorse",
          "label": "Avizează",
          "to": "director_approval",
          "requiresSignatures": [
            "visit_report"
          ]
        },
        {
          "key": "return",
          "label": "Returnează la expert",
          "to": "visit",
          "kind": "return",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "director_approval",
      "type": "human",
      "name": "Aprobare director",
      "assignment": {
        "rule": "role_queue",
        "role": "director"
      },
      "fieldAccess": {
        "follow_up_notes": "hidden"
      },
      "paths": [
        {
          "key": "approve",
          "label": "Aprobă raportul",
          "to": "communicate",
          "requiresSignatures": [
            "visit_report"
          ]
        },
        {
          "key": "return",
          "label": "Returnează",
          "to": "head_review",
          "kind": "return",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "communicate",
      "type": "system",
      "name": "Comunicarea raportului prin MySMIS",
      "onEnter": [
        {
          "type": "register",
          "register": "general",
          "direction": "out",
          "document": "visit_report"
        },
        {
          "type": "notify",
          "to": "beneficiary_email",
          "template": "p8_visit_report_email",
          "attach": [
            "visit_report"
          ]
        }
      ],
      "next": "route_result"
    },
    {
      "key": "route_result",
      "type": "decision",
      "name": "Rezultatul vizitei",
      "paths": [
        {
          "key": "ok",
          "label": "Conform",
          "to": "done",
          "visibleWhen": {
            "==": [
              {
                "var": "fields.result"
              },
              "conform"
            ]
          }
        },
        {
          "key": "recommendations",
          "label": "Cu recomandări",
          "to": "follow_up",
          "visibleWhen": {
            "==": [
              {
                "var": "fields.result"
              },
              "conform_cu_recomandari"
            ]
          }
        },
        {
          "key": "nonconform",
          "label": "Neconform",
          "to": "report_irregularity",
          "visibleWhen": {
            "==": [
              {
                "var": "fields.result"
              },
              "neconform"
            ]
          }
        }
      ]
    },
    {
      "key": "follow_up",
      "type": "human",
      "name": "Urmărirea recomandărilor",
      "assignment": {
        "rule": "previous_actor",
        "step": "visit",
        "role": "ei_expert"
      },
      "deadline": "follow_up",
      "fieldAccess": {
        "smis_code": "visible",
        "project_title": "visible",
        "beneficiary_name": "visible",
        "contract_number": "visible",
        "visit_reason": "visible",
        "project_kind": "visible",
        "visit_scope": "visible",
        "sampled_reference": "visible",
        "planned_date": "visible",
        "location": "visible",
        "beneficiary_contact": "visible",
        "notice_documents": "visible",
        "visibility_requirement": "visible",
        "team": "visible",
        "declared_progress": "visible",
        "stage_indicators_due": "visible",
        "main_risk": "visible",
        "equipment": "visible",
        "works_sampling": "visible",
        "previous_recommendations": "visible",
        "visit_date": "visible",
        "beneficiary_participants": "visible",
        "representative": "visible",
        "representative_role": "visible",
        "documents_checked": "visible",
        "contract_findings": "visible",
        "procurement_findings": "visible",
        "stage_findings": "visible",
        "indicators_findings": "visible",
        "equipment_findings": "visible",
        "works_findings": "visible",
        "deliverables_findings": "visible",
        "payments_findings": "visible",
        "durability_findings": "visible",
        "management_findings": "visible",
        "horizontal_findings": "visible",
        "visibility_findings": "visible",
        "other_findings": "visible",
        "risks": "visible",
        "findings": "visible",
        "deviation_type": "visible",
        "result": "visible",
        "recommendations": "editable",
        "beneficiary_position": "visible",
        "missing_documents": "visible",
        "escalation_level": "editable",
        "follow_up_notes": "required"
      },
      "paths": [
        {
          "key": "implemented",
          "label": "Recomandări implementate – închide",
          "to": "done",
          "validations": [
            {
              "rule": {
                "none": [
                  {
                    "var": "fields.recommendations"
                  },
                  {
                    "!=": [
                      {
                        "var": "status"
                      },
                      "implementata"
                    ]
                  }
                ]
              },
              "message": "Toate recomandările trebuie să fie marcate „implementată” (cu dovada încărcată în MySMIS)."
            }
          ]
        },
        {
          "key": "new_visit",
          "label": "Verificare la fața locului nouă",
          "to": "done",
          "requiresComment": true,
          "actions": [
            {
              "type": "start_subflow",
              "subflow": "p8_onsite_verification",
              "inputs": {
                "visit_reason": "=monitorizare",
                "location": "location",
                "beneficiary_contact": "beneficiary_contact",
                "project_kind": "project_kind"
              }
            }
          ]
        },
        {
          "key": "not_implemented",
          "label": "Recomandări neimplementate – sesizează nereguli",
          "to": "report_irregularity",
          "requiresComment": true
        }
      ]
    },
    {
      "key": "report_irregularity",
      "type": "system",
      "name": "Sesizare către nereguli",
      "onEnter": [
        {
          "type": "start_subflow",
          "subflow": "p4_irregularities",
          "inputs": {
            "source": "=vizita",
            "suspicion": "findings"
          }
        }
      ],
      "next": "closed_irregularity"
    },
    {
      "key": "done",
      "type": "end_positive",
      "name": "Finalizat"
    },
    {
      "key": "closed_irregularity",
      "type": "end_positive",
      "name": "Finalizat – sesizare nereguli"
    },
    {
      "key": "cancelled",
      "type": "end_negative",
      "name": "Anulat"
    }
  ],
  "conflictOfInterest": {
    "steps": [
      "prepare",
      "visit",
      "head_review",
      "director_approval"
    ],
    "statement": "Declar pe propria răspundere că nu mă aflu în conflict de interese cu beneficiarul sau cu furnizorii acestuia, că voi păstra confidențialitatea informațiilor obținute și că nu voi accepta cadouri, mese sau transport din partea beneficiarului."
  }
}
