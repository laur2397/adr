          "label": "Dovada cerută",
          "type": "text"
        },
        {
          "key": "status",
          "label": "Stadiu",
          "type": "choice",
          "nomenclature": "recommendation_status"
        }
      ],
      "rowValidations": [
        {
          "rule": {
            "and": [
              {
                "!!": {
                  "var": "row.recommendation"
                }
              },
              {
                "!!": {
                  "var": "row.deadline"
                }
              },
              {
                "!!": {
                  "var": "row.evidence_required"
                }
              }
            ]
          },
          "message": "fiecare recomandare are text, termen și dovada cerută."
        }
      ]
    },
