# --- required -----------------------------------------------------------------------------
# Database password (any long random string): openssl rand -base64 24
POSTGRES_PASSWORD=
# Key that encrypts 2FA secrets (32 bytes, base64): openssl rand -base64 32  — keep it with the backups
APP_KEY=
# Institution
ORG_NAME=Agenția pentru Dezvoltare Regională ...
ORG_CUI=
# First administrator (change the password after the first login)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@institutie.ro
ADMIN_PASSWORD=

# --- network ------------------------------------------------------------------------------
HTTP_PORT=8080
# Address users open (used in e-mail links)
PUBLIC_URL=https://flux.institutie.ro
# Behind HTTPS (reverse proxy) keep true; set false only for a test install on plain HTTP
SECURE_COOKIES=true

# --- e-mail (optional; without it notifications stay in the application) ------------------
SMTP_URL=
MAIL_FROM=flux-am@institutie.ro

# --- integrations ---------------------------------------------------------------------------
# ANAF public web service: live | mock
ANAF_MODE=live
# Qualified signature provider adapter. "simulated" is for tests only and refused in production.
SIGNATURE_PROVIDER=simulated
# Test/pilot installs only: accept simulated signatures (documents are stamped "SIMULARE").
ALLOW_SIMULATED_SIGNATURES=false
# EU DSS validation service for signed PDFs received (optional)
DSS_URL=

# --- demo data (never in production) ------------------------------------------------------
SEED_DEMO=false

# --- images (override to use an internal registry mirror) --------------------------------
# POSTGRES_IMAGE=postgres:16
# GOTENBERG_IMAGE=gotenberg/gotenberg:8
